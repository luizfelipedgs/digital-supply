{
  "name": "editor-de-musicas-desktop",
  "productName": "Editor de Músicas",
  "version": "1.0.0",
  "description": "Coloca música em lote nos seus vídeos, processando no seu próprio computador — versão desktop do Editor de Músicas (Digital Supply).",
  "main": "src/main.js",
  "author": "Digital Supply",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.digitalsupply.editordemusicas",
    "productName": "Editor de Músicas",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "EditorDeMusicas-Setup.exe"
    }
  }
}
