# Copie este arquivo para ".env.local" e preencha com os valores reais.
# Nunca cometa o ".env.local" no Git — ele já está no .gitignore.

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Painel da Cakto > Integrações > Webhooks > (ao criar o webhook, você define essa chave)
CAKTO_WEBHOOK_SECRET=

# Painel da Cakto > Produtos > (abra cada produto e copie o ID, não o short_id do link)
CAKTO_PRODUCT_ID_MENSAL=
CAKTO_PRODUCT_ID_TRIMESTRAL=
CAKTO_PRODUCT_ID_ANUAL=
